TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
WEB_APP_URL=https://your-domain.com

# Служебный чат/группа (пользователи НЕ вступают). Бот — админ.
SERVICE_CHAT_ID=-100xxxxxxxxxx

# HMAC-секрет для нативного Android-клиента (Telegram X).
# Минимум 32 случайных символа. Один и тот же секрет — в .env бота и в APK.
NATIVE_CLIENT_SECRET=generate-a-long-random-secret-at-least-32-chars

# BOT_WEBHOOK_URL=https://your-domain.com/bot/webhook
# TELEGRAM_WEBHOOK_SECRET=

PORT=3000
DATA_DIR=./data
